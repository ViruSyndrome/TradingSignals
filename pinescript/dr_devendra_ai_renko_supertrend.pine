//@version=5
indicator("Dr Devendra AI Renko Supertrend™", shorttitle="Dr Devendra AI Renko ST", overlay=true, max_labels_count=500)

// ============================================================================
// AI RENKO SUPERTREND SETTINGS (Matches Dr Devendra's Input UI)
// ============================================================================
grp_st = "AI RENKO SUPERTREND SETTINGS"
atrLength       = input.int(14,     "ATR Length",          minval=1, group=grp_st)
baseFactor      = input.float(3.0,  "Base Factor",         minval=0.5, step=0.5, group=grp_st)
autoBrickSize   = input.bool(false, "Auto Brick Size",     group=grp_st)
manualBrickSize = input.float(33.33,"Manual Brick Size",   minval=0.01, step=0.01, group=grp_st)
choppyFilterAdx = input.bool(false, "Choppy Filter (ADX)", group=grp_st)
adxThreshold    = input.int(15,     "ADX Threshold",       minval=1, maxval=50, group=grp_st)
bullColor       = input.color(#52b768, "Bull Color",       group=grp_st)
bearColor       = input.color(#e65c5c, "Bear Color",       group=grp_st)

// ============================================================================
// 1. ATR, ADX & BRICK SIZE CALCULATION
// ============================================================================
atrVal = ta.atr(atrLength)
[diPlus, diMinus, adxVal] = ta.dmi(14, 14)

brickSize = autoBrickSize ? math.max(atrVal * 0.5, close * 0.0005) : math.max(manualBrickSize, syminfo.mintick)

// ============================================================================
// 2. NON-REPAINTING SYNTHETIC RENKO BRICK QUANTIZATION ON CANDLES
// ============================================================================
var float renkoClose = na
var float renkoOpen  = na
var int   renkoDir   = 1

if na(renkoClose)
    renkoClose := math.round(close / brickSize) * brickSize
    renkoOpen  := renkoClose - brickSize
    renkoDir   := 1
else
    if renkoDir >= 0
        if close >= renkoClose + brickSize
            bricksUp   = math.floor((close - renkoClose) / brickSize)
            renkoOpen  := renkoClose + (bricksUp - 1) * brickSize
            renkoClose := renkoClose + bricksUp * brickSize
            renkoDir   := 1
        else if close <= renkoClose - 2.0 * brickSize
            bricksDn   = math.floor((renkoClose - close) / brickSize)
            renkoOpen  := renkoClose - (bricksDn - 1) * brickSize
            renkoClose := renkoClose - bricksDn * brickSize
            renkoDir   := -1
    else
        if close <= renkoClose - brickSize
            bricksDn   = math.floor((renkoClose - close) / brickSize)
            renkoOpen  := renkoClose - (bricksDn - 1) * brickSize
            renkoClose := renkoClose - bricksDn * brickSize
            renkoDir   := -1
        else if close >= renkoClose + 2.0 * brickSize
            bricksUp   = math.floor((close - renkoClose) / brickSize)
            renkoOpen  := renkoClose + (bricksUp - 1) * brickSize
            renkoClose := renkoClose + bricksUp * brickSize
            renkoDir   := 1

// ============================================================================
// 3. RENKO-QUANTIZED SUPERTREND BANDS & CHOPPY FILTER
// ============================================================================
rawBandDist   = baseFactor * atrVal
quantizedDist = math.max(brickSize, math.round(rawBandDist / brickSize) * brickSize)

basicUpper = renkoClose + quantizedDist
basicLower = renkoClose - quantizedDist

var float upperBand = na
var float lowerBand = na
var int   trend     = 1

prevRenkoClose = nz(renkoClose[1], renkoClose)
upperBand := na(upperBand[1]) ? basicUpper : (basicUpper < upperBand[1] or prevRenkoClose > upperBand[1] ? basicUpper : upperBand[1])
lowerBand := na(lowerBand[1]) ? basicLower : (basicLower > lowerBand[1] or prevRenkoClose < lowerBand[1] ? basicLower : lowerBand[1])

prevTrend = nz(trend[1], 1)
adxPass   = not choppyFilterAdx or (adxVal >= adxThreshold)

if prevTrend == 1
    if close < lowerBand and renkoDir == -1 and adxPass
        trend     := -1
        upperBand := basicUpper
    else
        trend := 1
else
    if close > upperBand and renkoDir == 1 and adxPass
        trend     := 1
        lowerBand := basicLower
    else
        trend := -1

supertrend  = trend == 1 ? lowerBand : upperBand
smoothPrice = 0.5 * ta.ema(close, 5) + 0.5 * renkoClose

// ============================================================================
// 4. PLOTS (Matches 4 Status-Line Outputs & Shaded Cloud)
// ============================================================================
activeColor = trend == 1 ? bullColor : bearColor

p_st     = plot(supertrend,  "AI Renko Supertrend", color=activeColor, linewidth=2, style=plot.style_linebr)
p_smooth = plot(smoothPrice, "Smoothed Renko Line", color=color.new(color.black, 15), linewidth=1)
p_renko  = plot(renkoClose,  "Renko Brick Level",   color=color.new(activeColor, 65), style=plot.style_stepline)
plot(trend, "Trend State", display=display.status_line)

fill(p_st, p_smooth, color=color.new(activeColor, 82), title="AI Renko Cloud")

buySignal  = trend == 1 and prevTrend == -1
sellSignal = trend == -1 and prevTrend == 1

if buySignal
    label.new(bar_index, supertrend, "BUY\n▲", style=label.style_label_up, color=bullColor, textcolor=color.white, size=size.small)

if sellSignal
    label.new(bar_index, supertrend, "SELL\n▼", style=label.style_label_down, color=bearColor, textcolor=color.white, size=size.small)

alertcondition(buySignal,  "AI Renko Supertrend BUY",  "Dr Devendra AI Renko Supertrend flipped BULLISH (BUY)")
alertcondition(sellSignal, "AI Renko Supertrend SELL", "Dr Devendra AI Renko Supertrend flipped BEARISH (SELL)")
