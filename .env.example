TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_POLLING=false
# Alert on Binance new-listing CMS articles (never auto-buys). Set false to disable.
LISTINGS_ALERTS=true
PORT=3000

# ─── Red Bar ENTER alerts ────────────────────────────────────────────────────
# Preferred: turn Telegram notifications ON — bot sends short ENTER-only pings
# (Trade 1 / Trade 2 / sweep). No watch spam. Listings muted in redBarOnly mode.
#
# Optional extras (not required if Telegram is on):
# RESEND_API_KEY=re_xxxx
# ALERT_EMAIL=you@example.com
# ALERT_EMAIL_FROM=TrendRunner <alerts@yourdomain.com>
# NTFY_TOPIC=trendrunner-your-secret-topic
#
# DESK_URL=https://trendrunner.app
# REDBAR_SCAN_MS=120000
#
# REQUIRED for overnight Telegram on free Render (otherwise the service sleeps and
# PWA can still alert while Telegram stays silent):
# 1) Set RENDER_EXTERNAL_URL=https://YOUR-SERVICE.onrender.com  (Render provides this)
# 2) Either UptimeRobot (or similar) GET /health every 5 min,
#    OR GitHub secret RENDER_HEALTH_URL=https://YOUR-SERVICE.onrender.com/health
#       (workflow: .github/workflows/render-keepalive.yml — not a deploy)
#
# Desk → Telegram relay (when the open PWA sees ENTER):
# Paste the same https://YOUR-SERVICE.onrender.com into TrendRunner Settings → Bot URL
# Optional: ALERT_RELAY_SECRET=same_as_TRADE_API_SECRET (if set, desk must send that header)

# Owner click-to-trade (optional). Spot keys only — disable withdrawals on the key.
# TRADE_ENABLED=true
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# TRADE_API_SECRET=long_random_string_shared_with_pwa_sidebar
# TRADE_MAX_USDT=50
# TRADE_DEFAULT_TRAIL_PCT=2
